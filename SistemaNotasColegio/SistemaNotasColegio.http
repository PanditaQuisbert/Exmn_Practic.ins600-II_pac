@SistemaNotasColegio_HostAddress = http://localhost:5012
@tokenSecretaria = <pegar-token-de-login-secretaria>
@tokenProfesor = <pegar-token-de-login-profesor>

### Salud
GET {{SistemaNotasColegio_HostAddress}}/api/health
Accept: application/json

### Login de Secretaría
POST {{SistemaNotasColegio_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "nombreUsuario": "secretaria",
  "password": "<contraseña-configurada-en-user-secrets>"
}

### Login de Profesor
POST {{SistemaNotasColegio_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "nombreUsuario": "<usuario-profesor>",
  "password": "<contraseña>"
}

### Listar usuarios (Secretaría)
GET {{SistemaNotasColegio_HostAddress}}/api/usuarios?incluirInactivos=true
Authorization: Bearer {{tokenSecretaria}}
Accept: application/json

### Crear profesor (Secretaría)
POST {{SistemaNotasColegio_HostAddress}}/api/usuarios
Authorization: Bearer {{tokenSecretaria}}
Content-Type: application/json

{
  "cedula": "1712345678",
  "nombres": "Nombre",
  "apellidos": "Apellido",
  "correo": "profesor@colegio.local",
  "nombreUsuario": "profesor",
  "password": "<contraseña-de-al-menos-8-caracteres>",
  "rolId": 2
}

### Listar roles (Secretaría)
GET {{SistemaNotasColegio_HostAddress}}/api/roles
Authorization: Bearer {{tokenSecretaria}}
Accept: application/json

### Crear asignación profesor-materia (Secretaría)
POST {{SistemaNotasColegio_HostAddress}}/api/asignaciones
Authorization: Bearer {{tokenSecretaria}}
Content-Type: application/json

{
  "profesorId": 2,
  "materiaId": 1
}

### Listar asignaciones (Secretaría)
GET {{SistemaNotasColegio_HostAddress}}/api/asignaciones
Authorization: Bearer {{tokenSecretaria}}
Accept: application/json

### Acceso denegado para Profesor
GET {{SistemaNotasColegio_HostAddress}}/api/usuarios
Authorization: Bearer {{tokenProfesor}}
Accept: application/json

### Listar estudiantes (Secretaría)
GET {{SistemaNotasColegio_HostAddress}}/api/estudiantes?incluirInactivos=true
Authorization: Bearer {{tokenSecretaria}}
Accept: application/json

### Crear estudiante (Secretaría)
POST {{SistemaNotasColegio_HostAddress}}/api/estudiantes
Authorization: Bearer {{tokenSecretaria}}
Content-Type: application/json

{
  "cedula": "1712345678",
  "nombres": "Nombre",
  "apellidos": "Apellido"
}

### Consultar estudiante (Secretaría)
GET {{SistemaNotasColegio_HostAddress}}/api/estudiantes/1
Authorization: Bearer {{tokenSecretaria}}
Accept: application/json

### Modificar estudiante (Secretaría)
PUT {{SistemaNotasColegio_HostAddress}}/api/estudiantes/1
Authorization: Bearer {{tokenSecretaria}}
Content-Type: application/json

{
  "cedula": "1712345678",
  "nombres": "Nombre Modificado",
  "apellidos": "Apellido"
}

### Activar o desactivar estudiante (Secretaría)
PATCH {{SistemaNotasColegio_HostAddress}}/api/estudiantes/1/estado
Authorization: Bearer {{tokenSecretaria}}
Content-Type: application/json

{
  "activo": false
}

### Listar materias (Secretaría)
GET {{SistemaNotasColegio_HostAddress}}/api/materias?incluirInactivas=true
Authorization: Bearer {{tokenSecretaria}}
Accept: application/json

### Crear materia (Secretaría)
POST {{SistemaNotasColegio_HostAddress}}/api/materias
Authorization: Bearer {{tokenSecretaria}}
Content-Type: application/json

{
  "codigo": "MAT-001",
  "nombre": "Matemáticas"
}

### Consultar materia (Secretaría)
GET {{SistemaNotasColegio_HostAddress}}/api/materias/1
Authorization: Bearer {{tokenSecretaria}}
Accept: application/json

### Modificar materia (Secretaría)
PUT {{SistemaNotasColegio_HostAddress}}/api/materias/1
Authorization: Bearer {{tokenSecretaria}}
Content-Type: application/json

{
  "codigo": "MAT-001",
  "nombre": "Matemáticas Avanzadas"
}

### Activar o desactivar materia (Secretaría)
PATCH {{SistemaNotasColegio_HostAddress}}/api/materias/1/estado
Authorization: Bearer {{tokenSecretaria}}
Content-Type: application/json

{
  "activo": false
}

### Profesor no puede listar estudiantes (403)
GET {{SistemaNotasColegio_HostAddress}}/api/estudiantes
Authorization: Bearer {{tokenProfesor}}
Accept: application/json

### Sin token no se puede listar materias (401)
GET {{SistemaNotasColegio_HostAddress}}/api/materias
Accept: application/json

### ------------------------------------------------------------------
### ETAPA 4: CALIFICACIONES Y BOLETÍN
### ------------------------------------------------------------------

### Profesor: consultar sus materias asignadas (identidad tomada del JWT)
GET {{SistemaNotasColegio_HostAddress}}/api/profesores/mis-asignaciones
Authorization: Bearer {{tokenProfesor}}
Accept: application/json

### Profesor: listar calificaciones de sus materias asignadas
GET {{SistemaNotasColegio_HostAddress}}/api/calificaciones
Authorization: Bearer {{tokenProfesor}}
Accept: application/json

### Profesor: filtrar por estudiante
GET {{SistemaNotasColegio_HostAddress}}/api/calificaciones?estudianteId=1
Authorization: Bearer {{tokenProfesor}}
Accept: application/json

### Profesor: filtrar por materia
GET {{SistemaNotasColegio_HostAddress}}/api/calificaciones?materiaId=1
Authorization: Bearer {{tokenProfesor}}
Accept: application/json

### Profesor: filtrar por trimestre (1, 2 o 3)
GET {{SistemaNotasColegio_HostAddress}}/api/calificaciones?trimestre=1
Authorization: Bearer {{tokenProfesor}}
Accept: application/json

### Profesor: consultar una calificación por id
GET {{SistemaNotasColegio_HostAddress}}/api/calificaciones/1
Authorization: Bearer {{tokenProfesor}}
Accept: application/json

### Profesor: registrar una calificación (201)
### Nota entre 0 y 100. Duplicado estudiante/materia/trimestre -> 409.
POST {{SistemaNotasColegio_HostAddress}}/api/calificaciones
Authorization: Bearer {{tokenProfesor}}
Content-Type: application/json

{
  "estudianteId": 1,
  "materiaId": 1,
  "trimestre": 1,
  "nota": 80
}

### Profesor: corregir una calificación existente (200)
PUT {{SistemaNotasColegio_HostAddress}}/api/calificaciones/1
Authorization: Bearer {{tokenProfesor}}
Content-Type: application/json

{
  "nota": 85
}

### Profesor: intento de nota duplicada (409)
POST {{SistemaNotasColegio_HostAddress}}/api/calificaciones
Authorization: Bearer {{tokenProfesor}}
Content-Type: application/json

{
  "estudianteId": 1,
  "materiaId": 1,
  "trimestre": 1,
  "nota": 90
}

### Profesor: nota fuera de rango (400)
POST {{SistemaNotasColegio_HostAddress}}/api/calificaciones
Authorization: Bearer {{tokenProfesor}}
Content-Type: application/json

{
  "estudianteId": 1,
  "materiaId": 1,
  "trimestre": 2,
  "nota": 150
}

### Profesor: materia no asignada (403)
POST {{SistemaNotasColegio_HostAddress}}/api/calificaciones
Authorization: Bearer {{tokenProfesor}}
Content-Type: application/json

{
  "estudianteId": 1,
  "materiaId": 2,
  "trimestre": 1,
  "nota": 80
}

### Secretaría: consultar boletín del estudiante (200)
### Promedio anual solo con las tres notas; si falta alguna -> null + INCOMPLETO.
GET {{SistemaNotasColegio_HostAddress}}/api/boletines/estudiantes/1
Authorization: Bearer {{tokenSecretaria}}
Accept: application/json

### Secretaría: boletín de estudiante inexistente (404)
GET {{SistemaNotasColegio_HostAddress}}/api/boletines/estudiantes/999999
Authorization: Bearer {{tokenSecretaria}}
Accept: application/json

### Secretaría no puede registrar calificaciones (403)
POST {{SistemaNotasColegio_HostAddress}}/api/calificaciones
Authorization: Bearer {{tokenSecretaria}}
Content-Type: application/json

{
  "estudianteId": 1,
  "materiaId": 1,
  "trimestre": 2,
  "nota": 80
}

### Profesor no puede consultar boletines (403)
GET {{SistemaNotasColegio_HostAddress}}/api/boletines/estudiantes/1
Authorization: Bearer {{tokenProfesor}}
Accept: application/json

### Sin token no se pueden consultar calificaciones (401)
GET {{SistemaNotasColegio_HostAddress}}/api/calificaciones
Accept: application/json

### Token inválido (401)
GET {{SistemaNotasColegio_HostAddress}}/api/profesores/mis-asignaciones
Authorization: Bearer token.invalido.firma
Accept: application/json
